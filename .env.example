# Base path for static hosting: "/Innovathon-Mollendo/" on the project site, "/" on the custom domain.
VITE_BASE_PATH=/Innovathon-Mollendo/

# Public site origin used for canonical/OG tags.
VITE_SITE_URL=https://innovathonmollendo.tech

# Google Apps Script web app URL (Deploy > New deployment > Web app).
# Must be deployed as "Anyone" so the browser can post registrations.
VITE_APPS_SCRIPT_URL=

# Set to "true" to keep registrations in localStorage instead of posting to Apps Script.
VITE_USE_FAKE_REGISTRATION=false
