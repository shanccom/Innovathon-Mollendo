# URL pública del sitio web
VITE_SITE_URL=https://innovathonmollendo.pe

# URL del Web App de Google Apps Script (obtenida al implementar Code.gs)
# Deja en blanco para usar almacenamiento local (localStorage) en modo desarrollo
VITE_APPS_SCRIPT_URL=

# Forzar almacenamiento simulado en localStorage (true / false)
VITE_USE_FAKE_REGISTRATION=false
